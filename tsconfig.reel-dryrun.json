{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "#server/*": ["./server/*"],
      "~/*": ["./app/*"]
    }
  },
  "exclude": ["node_modules", ".nuxt", ".output", ".cloud-run-build", "tmp", "workers"]
}
