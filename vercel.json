{
  "$schema": "https://vercel.sh",
  "services": {
    "bot": {
      "root": ".",
      "buildCommand": "npm run build",
      "installCommand": "npm ci",
      "functions": {
        "**": {
          "maxDuration": 300,
          "includeFiles": "{public/assets/**,node_modules/ffmpeg-static/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "bot"
      }
    }
  ]
}
