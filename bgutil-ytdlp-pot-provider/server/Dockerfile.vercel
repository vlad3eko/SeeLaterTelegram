FROM node:24-bookworm

WORKDIR /app

RUN apt-get update && \
    apt-get install -y \
        build-essential \
        python3 \
        pkg-config \
        libcairo2-dev \
        libpango1.0-dev \
        libjpeg-dev \
        libgif-dev \
        librsvg2-dev && \
    rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./

RUN npm ci --omit=dev

COPY build ./build

CMD ["sh", "-c", "exec node build/main.js --host 0.0.0.0 --port ${PORT:-80}"]

